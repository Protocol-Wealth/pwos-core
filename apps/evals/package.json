{
  "name": "@protocolwealthos/evals",
  "version": "0.0.0",
  "description": "Deterministic eval and attack-test scorer for AI-assisted compliance systems: fixture loader, string and transcript predicates (tool calls, outbound bodies, URLs, stored values), multi-turn and untrusted-context cases, and a scorer self-test of canned bad answers. Hermetic by default; live-model execution is opt-in.",
  "private": false,
  "license": "MIT-0 OR Apache-2.0",
  "homepage": "https://github.com/Protocol-Wealth/pwos-core/tree/main/apps/evals#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Protocol-Wealth/pwos-core.git",
    "directory": "apps/evals"
  },
  "bugs": {
    "url": "https://github.com/Protocol-Wealth/pwos-core/issues"
  },
  "keywords": [
    "evals",
    "prompt-injection",
    "red-team",
    "ai-governance",
    "compliance",
    "ria"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "fixtures",
    "README.md",
    "LICENSE-MIT-0",
    "LICENSE-APACHE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "evals:offline": "tsx src/cli.ts",
    "evals:list": "tsx src/cli.ts --list",
    "evals:live:http": "tsx src/liveHttpCli.ts",
    "evals:selftest": "tsx src/selfTestCli.ts",
    "prepack": "node ../../scripts/copy-license-notice.mjs && pnpm run build"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "tsx": "^4.23.13",
    "vitest": "^5.0.3",
    "@types/node": "^26.6.1"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  }
}
